###############################################################################
# DukanOS — Coolify Environment Variables Template
#
# Copy the values below into the Coolify "Environment Variables" section for
# your Docker Compose resource. Variables use the same names as the ones
# referenced by docker-compose.yml via ${VAR:-default}.
#
# IMPORTANT: Change every `change_me_*` value before deploying to production.
###############################################################################

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=DukanOS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pos.shahzadhermes.com
FRONTEND_URL=https://pos.shahzadhermes.com

# Must list the bare hostname(s) of the domain you assign to the nginx service
# in Coolify (comma-separated, no scheme). Used by Sanctum for SPA auth.
SANCTUM_STATEFUL_DOMAINS=pos.shahzadhermes.com

# Application Key: Leave blank for auto-generation on first boot, or generate with `php artisan key:generate`
APP_KEY=

# ── PostgreSQL Database ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dukanos
DB_USERNAME=dukanos_user
DB_PASSWORD=change_me_db_password

# ── Redis Cache, Queue & Session Broker ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_CLIENT=phpredis

# ── Service Drivers ─────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Mail Service (Optional) ─────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@dukanos.pk
MAIL_FROM_NAME="DukanOS Operating System"

# ── Automated Deployment Hooks ──────────────────────────────────────────────
# Set RUN_SEED=true if you want to seed the initial demo data
RUN_MIGRATIONS=true
RUN_SEED=false
RUN_CACHE=true
GENERATE_APP_KEY=true

# ── Proxy Ingress ───────────────────────────────────────────────────────────
# Trust Coolify's Traefik reverse proxy headers
TRUSTED_PROXIES=*
