###############################################################################
# Webiface Revenue OS — Coolify environment variables
# DukanOS — Coolify Environment Variables Template
#
# Copy the values below into the Coolify "Environment Variables" section for
# your Docker Compose resource. Variables use the same names as the ones
# referenced by docker-compose.yml via ${VAR:-default}. Anything you leave
# unset falls back to the default noted in docker-compose.yml.
# Copy and paste the contents of this file into the "Environment Variables" tab
# of your Coolify Docker Compose resource.
#
# IMPORTANT: Change every `change_me_*` value before deploying to production.
# Replace any `change_me_*` values before deploying to production.
###############################################################################

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=DukanOS
APP_ENV=production
APP_DEBUG=false
APP_NAME=Webiface Revenue OS
APP_URL=https://crm.webiface.com
FRONTEND_URL=https://crm.webiface.com
APP_URL=https://app.dukanos.pk
FRONTEND_URL=https://app.dukanos.pk

# Must list the bare hostname(s) of the domain you assign to the nginx service
# in Coolify (comma-separated, no scheme). Used by Sanctum for SPA auth.
SANCTUM_STATEFUL_DOMAINS=crm.webiface.com
# Must match your public domain assigned to Nginx in Coolify (comma-separated, no scheme)
SANCTUM_STATEFUL_DOMAINS=app.dukanos.pk

# Leave empty to have the entrypoint auto-generate one. If you set it, use a
# base64-encoded 32-byte key, e.g. output of: php artisan key:generate
# Application Key: Leave blank for auto-generation on first boot, or generate with `php artisan key:generate`
APP_KEY=

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# ── PostgreSQL Database ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_DATABASE=webiface_crm
DB_USERNAME=webiface
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dukanos
DB_USERNAME=dukanos_user
DB_PASSWORD=change_me_db_password

# ── Redis ───────────────────────────────────────────────────────────────────
# ── Redis Cache, Queue & Session Broker ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_CLIENT=phpredis
REDIS_PASSWORD=change_me_redis_password

# ── Laravel services ────────────────────────────────────────────────────────
# ── Service Drivers ─────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=log
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Object storage (MinIO inside the stack) ─────────────────────────────────
# The backend talks to MinIO at http://minio:9000 (internal). To expose
# uploaded files via a public URL set AWS_URL to your CDN/domain.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me_minio_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=webiface-crm
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# ── Mail (optional) ─────────────────────────────────────────────────────────
# Default driver is "log" (no real email). Set to smtp and fill values to send.
# ── Mail Service (Optional) ─────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@webiface.com
MAIL_FROM_NAME=Webiface Revenue OS
MAIL_FROM_ADDRESS=noreply@dukanos.pk
MAIL_FROM_NAME="DukanOS Operating System"

# ── Entrypoint behaviour ────────────────────────────────────────────────────
# RUN_SEED=true loads demo/dev seed data. Leave false for production.
# ── Automated Deployment Hooks ──────────────────────────────────────────────
# Set RUN_SEED=true if you want to seed the initial Punjab Electric Store demo data
RUN_MIGRATIONS=true
RUN_SEED=false
RUN_CACHE=true
GENERATE_APP_KEY=true

# ── Trusted proxy ───────────────────────────────────────────────────────────
# Coolify's Traefik sits in front; "*" trusts all proxies.
# ── Proxy Ingress ───────────────────────────────────────────────────────────
# Trust Coolify's Traefik reverse proxy headers
TRUSTED_PROXIES=*
