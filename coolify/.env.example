###############################################################################
# DukanOS — Coolify Environment Variables Template
#
# Copy the values below into the Coolify "Environment Variables" tab for your
# Docker Compose resource (pos.shahzadhermes.com).
# Variables use the same names as referenced in docker-compose.yml via ${VAR:-default}.
###############################################################################

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=DukanOS
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pos.shahzadhermes.com
FRONTEND_URL=https://pos.shahzadhermes.com
SANCTUM_STATEFUL_DOMAINS=pos.shahzadhermes.com

# Application Key: Leave blank for auto-generation on first boot, or generate with `php artisan key:generate`
APP_KEY=

# ── PostgreSQL Database ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dukanos
DB_USERNAME=dukanos_user
DB_PASSWORD=change_me_db_password

# ── Redis Cache, Queue & Session Broker ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_CLIENT=phpredis

# ── Service Drivers ─────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Mail Service ────────────────────────────────────────────────────────────
# Store-user invitations are only ever delivered by email, so a working
# transport is required for onboarding. Set MAIL_MAILER=log to disable it.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
# Leave MAIL_SCHEME empty so Laravel selects smtps on port 465.
MAIL_SCHEME=
# Both values are required; empty credentials break every send silently.
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be an address the SMTP account is authorised to send as, otherwise
# SPF/DMARC rejects the invitation. Defaults to MAIL_USERNAME when unset.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="DukanOS"

# ── Automated Deployment Hooks ──────────────────────────────────────────────
RUN_MIGRATIONS=true
RUN_SEED=false
RUN_CACHE=true
GENERATE_APP_KEY=true

# ── Proxy Ingress ───────────────────────────────────────────────────────────
TRUSTED_PROXIES=*
