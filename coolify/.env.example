###############################################################################
# Webiface Revenue OS — Coolify environment variables
#
# Copy the values below into the Coolify "Environment Variables" section for
# your Docker Compose resource. Variables use the same names as the ones
# referenced by docker-compose.yml via ${VAR:-default}. Anything you leave
# unset falls back to the default noted in docker-compose.yml.
#
# IMPORTANT: Change every `change_me_*` value before deploying to production.
###############################################################################

# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_NAME=Webiface Revenue OS
APP_URL=https://crm.webiface.com
FRONTEND_URL=https://crm.webiface.com

# Must list the bare hostname(s) of the domain you assign to the nginx service
# in Coolify (comma-separated, no scheme). Used by Sanctum for SPA auth.
SANCTUM_STATEFUL_DOMAINS=crm.webiface.com

# Leave empty to have the entrypoint auto-generate one. If you set it, use a
# base64-encoded 32-byte key, e.g. output of: php artisan key:generate
APP_KEY=

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_DATABASE=webiface_crm
DB_USERNAME=webiface
DB_PASSWORD=change_me_db_password

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_PASSWORD=change_me_redis_password

# ── Laravel services ────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Object storage (MinIO inside the stack) ─────────────────────────────────
# The backend talks to MinIO at http://minio:9000 (internal). To expose
# uploaded files via a public URL set AWS_URL to your CDN/domain.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me_minio_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=webiface-crm
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# ── Mail (optional) ─────────────────────────────────────────────────────────
# Default driver is "log" (no real email). Set to smtp and fill values to send.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@webiface.com
MAIL_FROM_NAME=Webiface Revenue OS

# ── Entrypoint behaviour ────────────────────────────────────────────────────
# RUN_SEED=true loads demo/dev seed data. Leave false for production.
RUN_MIGRATIONS=true
RUN_SEED=false
RUN_CACHE=true
GENERATE_APP_KEY=true

# ── Trusted proxy ───────────────────────────────────────────────────────────
# Coolify's Traefik sits in front; "*" trusts all proxies.
TRUSTED_PROXIES=*
